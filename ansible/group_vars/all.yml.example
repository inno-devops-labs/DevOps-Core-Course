---
dockerhub_username: lab05-user
dockerhub_password: dummy-access-token-for-lab05

app_name: devops-app
docker_image: "{{ dockerhub_username }}/{{ app_name }}"
docker_image_tag: latest
app_port: 5000
app_container_name: "{{ app_name }}"

# Docker Compose specific configuration
app_internal_port: "{{ app_port }}"
compose_project_dir: "/opt/{{ app_name }}"
docker_compose_version: "3.8"

# Optional application environment variables
app_env: {}
