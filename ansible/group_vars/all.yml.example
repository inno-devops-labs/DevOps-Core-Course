# Copy this to group_vars/all.yml and encrypt with Ansible Vault:
#   ansible-vault create group_vars/all.yml
# Then paste the content below (with your real credentials).
---
# Docker Hub credentials (use access token, not password)
dockerhub_username: your-username
dockerhub_password: your-access-token

# Application configuration
app_name: devops-app
docker_image: "{{ dockerhub_username }}/{{ app_name }}"
docker_image_tag: latest
app_port: 5000
app_container_name: "{{ app_name }}"
