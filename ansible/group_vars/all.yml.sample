---
# Sample for vault. When using -i inventory/hosts.ini, put the encrypted file in
# inventory/group_vars/all.yml (not here). Create: ansible-vault create inventory/group_vars/all.yml

dockerhub_username: your-dockerhub-username
dockerhub_password: your-dockerhub-access-token

# Application (web_app role) — use docker_tag (not docker_image_tag)
app_name: devops-app
docker_image: "{{ dockerhub_username }}/{{ app_name }}"
docker_tag: lab03
app_port: 8000
app_internal_port: 8000
compose_project_dir: "/opt/{{ app_name }}"
# app_secret_key: encrypt with ansible-vault encrypt_string 'secret' --name 'app_secret_key'
