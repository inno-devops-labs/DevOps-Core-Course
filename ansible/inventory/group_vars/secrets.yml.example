---
# Example secrets file - THIS FILE IS NOT ENCRYPTED
# Use: ansible-vault encrypt ansible/inventory/group_vars/secrets.yml
# to encrypt this file with a password

# Database credentials (example)
db_password: change_me_and_encrypt
db_user: app_user
db_host: localhost
db_port: 5432

# API keys (example)
api_key: your_api_key_here
docker_hub_token: your_token_here

# SSL/TLS certificates paths (example)
ssl_cert_path: /etc/ssl/certs/app.crt
ssl_key_path: /etc/ssl/private/app.key

# Application secrets (example)
app_secret_key: super_secret_key_change_me
jwt_secret: jwt_secret_key_change_me
