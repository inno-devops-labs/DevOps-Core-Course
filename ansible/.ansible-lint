---
# Ansible-lint configuration for CI/CD

# Skip checks that require runtime connectivity or files
skip_list:
  - syntax-check  # Skip syntax-check that needs vault and inventory

# Use minimal profile for CI
profile: min

# Exclude specific paths
exclude_paths:
  - .vault_pass
  - inventory/

# Enable offline mode (don't check external dependencies)
offline: true

# Warn on unknown tags instead of failing
warn_list:
  - experimental
