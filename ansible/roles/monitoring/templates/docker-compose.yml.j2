version: "3.8"

networks:
  {{ monitoring_network }}:
    driver: bridge

volumes:
  loki-data:
  grafana-data:

services:

  loki:
    image: grafana/loki:{{ loki_version }}
    container_name: loki
    ports:
      - "{{ loki_port }}:{{ loki_port }}"
    command: -config.file=/etc/loki/config.yml
    volumes:
      - {{ monitoring_dir }}/loki/config.yml:/etc/loki/config.yml:ro
      - loki-data:/loki
    networks:
      - {{ monitoring_network }}
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:{{ loki_port }}/ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: '{{ loki_cpu_limit }}'
          memory: {{ loki_memory_limit }}
        reservations:
          cpus: '{{ loki_cpu_reservation }}'
          memory: {{ loki_memory_reservation }}
    restart: unless-stopped

  promtail:
    image: grafana/promtail:{{ promtail_version }}
    container_name: promtail
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - {{ monitoring_dir }}/promtail/config.yml:/etc/promtail/config.yml:ro
      - {{ docker_containers_path }}:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - {{ monitoring_network }}
    depends_on:
      loki:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: '{{ promtail_cpu_limit }}'
          memory: {{ promtail_memory_limit }}
        reservations:
          cpus: '{{ promtail_cpu_reservation }}'
          memory: {{ promtail_memory_reservation }}
    restart: unless-stopped

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    ports:
      - "{{ grafana_port }}:3000"
    environment:
      - GF_AUTH_ANONYMOUS_ENABLED={{ grafana_anonymous_enabled }}
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_SECURITY_ALLOW_EMBEDDING=false
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana-data:/var/lib/grafana
    networks:
      - {{ monitoring_network }}
    depends_on:
      loki:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: '{{ grafana_cpu_limit }}'
          memory: {{ grafana_memory_limit }}
        reservations:
          cpus: '{{ grafana_cpu_reservation }}'
          memory: {{ grafana_memory_reservation }}
    restart: unless-stopped

  app-python:
    image: {{ app_python_image }}
    container_name: app-python
    ports:
      - "{{ app_python_port }}:8000"
    environment:
      - SERVICE_NAME=devops-info-service
      - SERVICE_VERSION=1.0.0
      - HOST=0.0.0.0
      - PORT=8000
    networks:
      - {{ monitoring_network }}
    labels:
      logging: "promtail"
      app: "devops-python"
    depends_on:
      loki:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:8000/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      resources:
        limits:
          cpus: '{{ app_python_cpu_limit }}'
          memory: {{ app_python_memory_limit }}
        reservations:
          cpus: '{{ app_python_cpu_reservation }}'
          memory: {{ app_python_memory_reservation }}
    restart: unless-stopped
