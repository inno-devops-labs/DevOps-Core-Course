apiVersion: 1

datasources:
  - name: Loki
    uid: {{ monitoring_grafana_loki_datasource_uid }}
    type: loki
    access: proxy
    url: http://loki:3100
    isDefault: false
    editable: false

  - name: Prometheus
    uid: {{ monitoring_grafana_prometheus_datasource_uid }}
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
