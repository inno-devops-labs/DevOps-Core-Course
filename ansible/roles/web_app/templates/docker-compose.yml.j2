# Templated Docker Compose for {{ app_name }}
# Variables: app_name, docker_image, docker_tag (or docker_image_tag), app_port, app_internal_port
version: '{{ docker_compose_version }}'

services:
  {{ app_name }}:
    image: {{ docker_image }}:{{ docker_image_tag | default(docker_tag) | default('latest') }}
    container_name: {{ app_name }}
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
      - PORT={{ app_internal_port }}
{% if app_secret_key is defined %}
      - SECRET_KEY={{ app_secret_key }}
{% endif %}
{% for key, value in (app_env | default({})).items() %}
      - {{ key }}={{ value }}
{% endfor %}
    restart: unless-stopped
