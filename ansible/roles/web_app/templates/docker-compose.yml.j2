# Docker Compose template for {{ app_name }}
# Generated by Ansible - DO NOT EDIT MANUALLY

version: '{{ docker_compose_version | default("3.8") }}'

services:
  {{ app_name }}:
    image: {{ docker_image }}:{{ docker_tag }}
    container_name: {{ app_name }}
    ports:
      - "{{ app_port }}:{{ app_internal_port | default(app_port) }}"
{% if app_env_vars is defined and app_env_vars %}
    environment:
{% for key, value in app_env_vars.items() %}
      {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% if app_volumes is defined and app_volumes %}
    volumes:
{% for volume in app_volumes %}
      - {{ volume }}
{% endfor %}
{% endif %}
{% if app_networks is defined and app_networks %}
    networks:
{% for network in app_networks %}
      - {{ network }}
{% endfor %}
{% endif %}
    restart: {{ app_restart_policy | default('unless-stopped') }}
{% if app_healthcheck is defined %}
    healthcheck:
      test: {{ app_healthcheck.test }}
      interval: {{ app_healthcheck.interval | default('30s') }}
      timeout: {{ app_healthcheck.timeout | default('10s') }}
      retries: {{ app_healthcheck.retries | default(3) }}
{% endif %}
    labels:
      - "app.managed_by=ansible"
      - "app.name={{ app_name }}"
      - "app.environment={{ app_environment | default('production') }}"

{% if app_networks is defined and app_networks %}
networks:
{% for network in app_networks %}
  {{ network }}:
    driver: bridge
{% endfor %}
{% endif %}

{% if app_volumes_defined is defined and app_volumes_defined %}
volumes:
{% for volume in app_volumes_defined %}
  {{ volume.name }}:
    driver: {{ volume.driver | default('local') }}
{% endfor %}
{% endif %}
