---
# Docker Compose configuration for {{ app_name }}
# Generated by Ansible — do not edit manually

services:
  {{ app_name }}:
    image: {{ docker_image }}:{{ docker_tag }}
    container_name: {{ app_name }}
    restart: unless-stopped
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
      HOST: "0.0.0.0"
      PORT: "{{ app_internal_port }}"
{% if app_env_vars is defined %}
{% for key, value in app_env_vars.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ app_internal_port }}/health || wget -q -O- http://localhost:{{ app_internal_port }}/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
