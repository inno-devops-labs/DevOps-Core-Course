{# docker-compose.yml.j2 - Generated by Ansible for {{ web_app_name }} #}
{# Variables: web_app_name, web_app_docker_image, web_app_docker_tag,        #}
{#            web_app_port, web_app_internal_port,                            #}
{#            web_app_restart_policy, web_app_env                             #}
version: '{{ web_app_compose_version }}'

services:
  {{ web_app_name }}:
    image: {{ web_app_docker_image }}:{{ web_app_docker_tag }}
    container_name: {{ web_app_name }}
    ports:
      - "{{ web_app_port }}:{{ web_app_internal_port }}"
    environment:
{% if web_app_env %}
{% for key, value in web_app_env.items() %}
      - {{ key }}={{ value }}
{% endfor %}
{% endif %}
      - APP_NAME={{ web_app_name }}
    restart: {{ web_app_restart_policy }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% if web_app_healthcheck_cmd is defined %}
    healthcheck:
      test: {{ web_app_healthcheck_cmd }}
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
{% endif %}
