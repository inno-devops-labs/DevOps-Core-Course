# Templated Docker Compose for {{ app_name }}
# Variables: app_name, docker_image, docker_tag, app_port, app_internal_port, app_env
# (version is obsolete in Compose v2 and ignored)
services:
  {{ app_name }}:
    image: "{{ docker_image }}:{{ docker_tag | default(docker_image_tag) | default('latest') }}"
    container_name: "{{ app_name }}"
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
      - PORT={{ app_internal_port }}
{% if (app_env | default({})) is mapping %}
{% for key, value in (app_env | default({})).items() %}
      - {{ key }}={{ value }}
{% endfor %}
{% endif %}
    restart: {{ app_restart_policy | default('unless-stopped') }}
