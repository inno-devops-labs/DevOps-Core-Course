# Variables:
# - app_name: service/container name
# - docker_image, docker_image_tag: image reference
# - app_port, app_internal_port: host:container ports
# - web_app_env: dict of environment variables (Vault values can be used)

version: "{{ docker_compose_version }}"

services:
  {{ app_name }}:
    image: "{{ docker_image }}:{{ docker_image_tag }}"
    container_name: "{{ app_name }}"
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
{% for k, v in web_app_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    restart: unless-stopped
