version: "{{ web_app_docker_compose_version | default('3.8') }}"

services:
  {{ web_app_name | default('devops-app') }}:
    image: "{{ web_app_docker_image }}:{{ web_app_docker_tag | default('latest') }}"
    container_name: "{{ web_app_name | default('devops-app') }}"
    ports:
      - "{{ web_app_port | default(8000) }}:{{ web_app_internal_port | default(8000) }}"
    environment:
      APP_SECRET_KEY: "{{ app_secret_key }}"
    restart: unless-stopped
