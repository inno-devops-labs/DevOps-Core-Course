---
services:
  {{ app_name }}:
    image: {{ docker_image }}:{{ docker_tag }}
    container_name: {{ app_name }}
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
{% for key, value in app_env_vars.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% if app_secret_key is defined %}
      SECRET_KEY: "{{ app_secret_key }}"
{% endif %}
    restart: {{ app_restart_policy }}
    networks:
      - app_network

networks:
  app_network:
    driver: bridge
