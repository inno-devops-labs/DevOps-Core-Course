# Docker Compose template for {{ web_app_app_name }}
# Generated by Ansible

services:
  {{ web_app_app_name }}:
    image: {{ docker_image }}:{{ web_app_docker_tag }}
    container_name: {{ web_app_app_name }}
    ports:
      - "{{ web_app_app_port }}:{{ web_app_app_internal_port }}"
    restart: {{ web_app_restart_policy }}
{% if web_app_app_env is defined and web_app_app_env | length > 0 %}
    environment:
{% for key, value in web_app_app_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if web_app_app_healthcheck is defined and web_app_app_healthcheck %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ web_app_app_internal_port }}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
{% endif %}
