{# docker-compose.yml.j2 - Generated by Ansible for {{ app_name }} #}
{# Variables: app_name, docker_image, docker_tag, app_port, app_internal_port, #}
{#            app_restart_policy, app_env                                        #}
version: '{{ docker_compose_version }}'

services:
  {{ app_name }}:
    image: {{ docker_image }}:{{ docker_tag }}
    container_name: {{ app_name }}
    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    environment:
{% if app_env %}
{% for key, value in app_env.items() %}
      - {{ key }}={{ value }}
{% endfor %}
{% endif %}
      - APP_NAME={{ app_name }}
    restart: {{ app_restart_policy }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% if app_healthcheck_cmd is defined %}
    healthcheck:
      test: {{ app_healthcheck_cmd }}
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
{% endif %}
