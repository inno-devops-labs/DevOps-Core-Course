{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edge-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-14",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"APP_NAME": "devops-edge-api",
		"COURSE_NAME": "devops-core"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "057ff4467ab5453f86baa507ccdd3de4"
		}
	]
}
