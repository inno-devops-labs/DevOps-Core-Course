{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  // Plaintext vars (not secrets — visible in dashboard and bundle metadata).
  "vars": {
    "APP_NAME": "edge-api",
    "COURSE_NAME": "devops-core"
  },
  // Replace id after: npx wrangler kv namespace create SETTINGS
  // Optional preview_id after: npx wrangler kv namespace create SETTINGS --preview
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "7359fb1c829644ce886ddd65f4001fcf",
      "preview_id": "0a51f6df9759438c89d491360959fb29"
    }
  ]
}
