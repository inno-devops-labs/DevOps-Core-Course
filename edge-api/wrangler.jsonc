{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",

  // Plaintext environment variables (non-sensitive configuration)
  "vars": {
    "APP_NAME": "edge-api",
    "COURSE_NAME": "devops-core"
  },

  // KV namespace binding — replace <YOUR_NAMESPACE_ID> after running:
  //   npx wrangler kv namespace create SETTINGS
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "939d5ba95083492da53b9dcf76b01710"
    }
  ]
}
