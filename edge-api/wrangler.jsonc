{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_NAME": "edge-api",
    "COURSE_NAME": "DevOps Core Course",
    "APP_VERSION": "1.0.1"
  },
  "secrets": {
    "required": ["API_TOKEN", "ADMIN_EMAIL"]
  },
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "cb5b72b2ab72416a9cf6f6f79841a348"
    }
  ]
}
