{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edge-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"APP_NAME": "edge-api",
		"COURSE_NAME": "DevOps Core S26",
		"APP_VERSION": "1.0.1",
		"ENVIRONMENT": "production"
	},
	"secrets": {
		"required": [
			"API_TOKEN",
			"ADMIN_EMAIL"
		]
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "a7dd06a571e7468d9906db5d52c32d12"
		}
	]
}
