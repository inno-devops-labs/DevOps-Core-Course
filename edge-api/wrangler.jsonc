		"ENVIRONMENT": "production",
		"APP_VERSION": "lab17-task4"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "bb5424b69bb84e0cafe3c5884814c065"
		}
	]
}
