{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edge-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-13",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"APP_NAME": "edge-api",
		"COURSE_NAME": "devops-core",
		"ENVIRONMENT": "production",
		"API_VERSION": "1.0.1"
	},
	"secrets": {
		"required": [
			"API_TOKEN",
			"ADMIN_EMAIL"
		]
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "b2e9980fe2844a7684c62d0eedab1120"
		}
	]
}
