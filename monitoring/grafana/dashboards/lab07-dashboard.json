{
  "uid": "lab07",
  "title": "Lab 07 Logs Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "logs",
      "title": "Logs (All Apps)",
      "id": 1,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{app=~\"devops-.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "type": "timeseries",
      "title": "Request Rate (by App)",
      "id": 2,
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (app) (rate({app=~\"devops-.*\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Error Logs",
      "id": 3,
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{app=~\"devops-.*\"} | json | level=\"ERROR\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "type": "piechart",
      "title": "Log Level Distribution",
      "id": 4,
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({app=~\"devops-.*\"} | json [5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
