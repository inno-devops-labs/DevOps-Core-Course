# ──────────────────────────────────────────────────────────────
# docker-compose.yml.j2  — Jinja2 template (Task 2, Lab 6)
#
# Ansible renders this with the `template` module before copying
# it to {{ compose_project_dir }}/docker-compose.yml on the VM.
# Every template variable is replaced with its value at run time.
# ──────────────────────────────────────────────────────────────

services:
  {{ app_name }}:
    # Service name = Compose internal DNS name (other containers can
    # reach this one by hostname "{{ app_name }}").

    image: {{ docker_image }}:{{ docker_tag }}
    # Full image reference.  Compose will pull from Docker Hub if the
    # image is not already cached locally.

    container_name: {{ app_container_name | default(app_name) }}
    # Explicit name avoids the default "<project>_<service>_1" suffix,
    # making it easier to reference the container in scripts.

    ports:
      - "{{ app_port }}:{{ app_internal_port }}"
    # HOST_PORT:CONTAINER_PORT mapping.
    # Separating them (app_port vs app_internal_port) lets us expose the
    # same container image on different host ports without changing the app.

    environment:
      # Non-sensitive runtime configuration.
      # Sensitive values (API keys, passwords) should come from Vault
      # and be passed via extra_vars or an .env file — never hardcoded here.
      APP_PORT: "{{ app_internal_port }}"
      APP_ENV: "production"

    restart: unless-stopped
    # unless-stopped: restart on failure or host reboot, but NOT if the
    # container was explicitly stopped with `docker stop` or `docker compose down`.
    # Compare: "always" restarts even after an intentional stop — usually unwanted.

    healthcheck:
      # Docker will call this command periodically.  If it fails `retries`
      # times in a row the container is marked "unhealthy" and visible in
      # `docker ps` — useful for monitoring and CI verification steps.
      test: ["CMD", "curl", "-f", "http://localhost:{{ app_internal_port }}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
      # start_period: grace time after container start before health failures count.

networks:
  default:
    name: "{{ app_name }}_net"
    # A dedicated bridge network for the project.
    # Bridge networks provide isolation — containers outside this network
    # cannot reach the service by name, only via the published host port.
